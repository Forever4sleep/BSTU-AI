# Прокси Vite на API (локально: localhost:8001; в compose сервис problem-platform-ui задаёт ingestion-service)
# DEV_PROXY_TARGET=http://localhost:8001

# Если браузер ходит на другой origin без прокси (оставьте пустым при npm run dev + proxy).
# Корень только хост (+опц. порт), без финального „/api“ — код сам собирает /api/platform/...
# Если всё-таки указываете …:8001/api, сборщик уберёт дублирующий /api из пути.
# VITE_API_BASE=http://localhost:8001
