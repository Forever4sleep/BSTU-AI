# Main Telegram Bot (student-facing)
TELEGRAM_BOT_TOKEN=your_main_bot_token_here

# OpenRouter (for LLM and intent classification)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
ENABLE_THINKING=true

# Ingestion Service (RAG pipeline)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=bstu_materials
# RAG in /v1/chat/completions (Open WebUI → ingestion-service; ClassifiedRAG = BM25 + dense)
RAG_ENABLED=true
RAG_TOP_K=5
RAG_BM25_K=5
RAG_BM25_MAX_DOCS=10000
RAG_HYBRID_ALPHA=0.5
RAG_QUERY_MAX_TURNS=3
RAG_RELEVANCE_THRESHOLD=0.4
INGESTION_SERVICE_PORT=8001
CELERY_BROKER_URL=redis://localhost:6379/0
# Chunking: sliding_window (fixed) | recursive (LangChain, semantic boundaries)
CHUNK_STRATEGY=sliding_window
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# Embeddings via OpenRouter (uses OPENROUTER_API_KEY above)
EMBEDDING_MODEL=openai/text-embedding-3-small
# VLM для PDF (Docling + OpenRouter)
VLM_MODEL=qwen/qwen-2.5-vl-7b-instruct
VLM_TIMEOUT=120

# LangSmith (RAG tracing / observability)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=bstu-ai-rag

# PostgreSQL (conversation storage)
INGESTION_DB_URL=postgresql+asyncpg://bstu:bstu_dev@localhost:5432/bstu_ai

# Upload Bot (admin document uploads)
UPLOAD_BOT_TOKEN=your_upload_bot_token_here
INGESTION_SERVICE_URL=http://localhost:8001
# Optional: restrict uploads to specific Telegram user IDs (comma-separated)
# ALLOWED_UPLOAD_USER_IDS=123456789,987654321
