# Main Telegram Bot (student-facing)
TELEGRAM_BOT_TOKEN=your_main_bot_token_here

# OpenRouter (for LLM and intent classification)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
ENABLE_THINKING=true

# Ingestion Service (RAG pipeline)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=bstu_materials
# RAG in /v1/chat/completions (Open WebUI → ingestion-service; ClassifiedRAG = BM25 + dense)
RAG_ENABLED=true
RAG_TOP_K=5
RAG_BM25_K=5
RAG_BM25_MAX_DOCS=10000
RAG_HYBRID_ALPHA=0.5
RAG_QUERY_MAX_TURNS=3
RAG_RELEVANCE_THRESHOLD=0.4
RAG_PROBLEM_MATCH_ENABLED=true
# Порог cosine similarity для базового античита (0..1); режим задаётся в настройках курса
RAG_PROBLEM_MATCH_THRESHOLD=0.82
INGESTION_SERVICE_PORT=8001
CELERY_BROKER_URL=redis://localhost:6379/0
# Chunking: sliding_window (fixed) | recursive (LangChain, semantic boundaries)
CHUNK_STRATEGY=sliding_window
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# Embeddings via OpenRouter (uses OPENROUTER_API_KEY above)
EMBEDDING_MODEL=openai/text-embedding-3-small
# VLM для PDF (Docling + OpenRouter)
VLM_MODEL=qwen/qwen-2.5-vl-7b-instruct
VLM_TIMEOUT=120
# Параллельных запросов к OpenRouter на одну PDF (Celery worker остаётся concurrency=1)
VLM_CONCURRENCY=4
# Страниц в одной партии (Docling page_batch_size; лог: "Processing batch of N images")
VLM_BATCH_SIZE=4

# LangSmith (RAG tracing / observability)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=bstu-ai-rag

# PostgreSQL (conversation storage)
INGESTION_DB_URL=postgresql+asyncpg://bstu:bstu_dev@localhost:5432/bstu_ai

# Problem platform
# Администратор платформы (/admin/login) — те же переменные, что и ниже JWT
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=change_this_admin_password
# Bootstrap преподавателя по секрету (опционально, см. POST /api/platform/instructors/bootstrap)
PLATFORM_BOOTSTRAP_SECRET=change_me_long_random
# HS256: преподаватель, админ платформы, студенты
PLATFORM_JWT_SECRET=change_me_another_long_random
# PLATFORM_JWT_EXPIRE_HOURS=168
# CORS для отдельного фронта (Vite dev и т.д.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CODE_JUDGE_TIMEOUT_SEC=8

# Фронт платформы задач (./frontend): docker compose --profile platform (см. frontend/.env.example)

# Upload Bot (admin document uploads)
UPLOAD_BOT_TOKEN=your_upload_bot_token_here
INGESTION_SERVICE_URL=http://localhost:8001
# Optional: restrict uploads to specific Telegram user IDs (comma-separated)
# ALLOWED_UPLOAD_USER_IDS=123456789,987654321
