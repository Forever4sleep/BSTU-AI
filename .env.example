# Main Telegram Bot (student-facing)
TELEGRAM_BOT_TOKEN=your_main_bot_token_here

# Database (use postgres:5432 when running via Docker Compose)
DATABASE_URL=postgresql://bstu:bstu@localhost:5432/bstu_ai

# OpenRouter (for LLM and intent classification)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Reminder Service
REMINDER_POLL_INTERVAL=60

# Ingestion Service (RAG pipeline)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=bstu_materials
INGESTION_SERVICE_PORT=8001
# Embeddings via OpenRouter (uses OPENROUTER_API_KEY above)
EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: override base URL (default: https://openrouter.ai/api/v1 when OPENROUTER_API_KEY is set)
# EMBEDDING_BASE_URL=

# Upload Bot (admin document uploads)
UPLOAD_BOT_TOKEN=your_upload_bot_token_here
INGESTION_SERVICE_URL=http://localhost:8001
# Optional: restrict uploads to specific Telegram user IDs (comma-separated)
# ALLOWED_UPLOAD_USER_IDS=123456789,987654321

# Docker Compose: DATABASE_URL and INGESTION_SERVICE_URL are overridden per-service.
# Postgres defaults: user=bstu, password=bstu, db=bstu_ai
